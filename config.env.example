# Copy to config.env (which is gitignored) and edit. All values have sane
# defaults baked into the scripts; only set what you need to override.

# --- UDM target ---
UDM_HOST=192.168.0.1
UDM_USER=root
SSH_KEY=$HOME/.ssh/udm_restore_ed25519
KNOWN_HOSTS=$HOME/.ssh/udm_known_hosts

# --- watchdog behaviour ---
LOG_STALE_HOURS=24          # log older than this AND dnsmasq dead => LOG_STALE
GRACE_SECONDS=90            # defer to on-box self-heal (60s) before acting on CONF_MISSING
MAX_REPAIRS_PER_HOUR=3      # flap guard: pause auto-restore beyond this
GIT_PULL_MIN_INTERVAL=3600  # hourly ff-only pull of the restore copy

# --- alerting (secrets live in ~/.config/udm-watchdog/gmail.secret, NOT here) ---
# NOTIFY=$HOME/udm-dhcp-logging/pi/notify-gmail.sh
