[Unit]
Description=Off-box watchdog: verify + restore UDM DHCP logging
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Placeholders below are substituted with absolute values by install-pi-watchdog.sh
# (systemd %h is unreliable in a system unit, so we bake in the real path/user).
User=__RUN_USER__
ExecStart=__CHECK_SCRIPT__
Nice=10
