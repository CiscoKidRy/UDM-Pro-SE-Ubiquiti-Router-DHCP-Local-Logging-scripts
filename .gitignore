# ============ SECRETS — never commit ============
# Private SSH keys (any form)
*_ed25519
*_rsa
*_ecdsa
id_*
*.pem
*.ppk
*.key

# Tokens / app passwords / bearer creds
*.secret
*.token
*.jwt
.env
config.env
*app*password*

# Provisioning files known to carry live secrets
firstrun.sh
**/firstrun.sh
wpa_supplicant.conf
*.shadow

# Host key caches (machine-specific)
known_hosts
*known_hosts*

# ============ Runtime / local noise ============
*.log
*.tmp
*.gz
__pycache__/
